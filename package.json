{
  "name": "dsh-plugin-speechio-fast",
  "version": "0.3.1",
  "description": "本机语音输入：在 DSH 输入框模型选择器与发送按钮之间加一个麦克风按钮，用本地 Qwen3-ASR（llama.cpp）把说的话按句直接写进消息输入框。支持 GPU（Vulkan）/ CPU 切换。程序与模型解耦，模型需自行下载。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "voice-input",
    "speech-to-text",
    "streaming-asr",
    "asr",
    "qwen3-asr",
    "llama.cpp",
    "vulkan"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "scripts/setup.ps1",
    "scripts/bench.mjs",
    "scripts/test-asr.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "icon": "icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  }
}
